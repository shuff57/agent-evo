{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "PYTHONUTF8": "1",
    "ODYSSEUS_URL": "http://127.0.0.1:7000"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "hyperframes": "off",
    "hyperframes-animation": "off",
    "hyperframes-cli": "off",
    "hyperframes-core": "off",
    "hyperframes-creative": "off",
    "hyperframes-keyframes": "off",
    "hyperframes-registry": "off",
    "media-use": "off",
    "parallel-build": "off",
    "roster-match": "off",
    "caveman-compress": "off",
    "steve": "off",
    "caveman-review": "off",
    "security-audit": "off",
    "grill-with-docs": "off",
    "officecli": "off",
    "humanizer": "off",
    "improve-codebase-architecture": "off",
    "odysseus": "off",
    "switch-computers": "on"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/bin/msg.mjs guard --as claude --hook"
          },
          {
            "type": "command",
            "command": "node $HOME/Documents/GitHub/agent-evo/hooks/tier-gate.js"
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/bin/bash-trap-warn.mjs"
          },
          {
            "type": "command",
            "command": "node $HOME/Documents/GitHub/agent-evo/hooks/tier-gate.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/metrics-capture.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/metrics-capture.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "superpowers@superpowers-dev": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "teammateMode": "auto",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "skipWorkflowUsageWarning": true
}
